{
  "name": "m3-cards",
  "version": "2.3.2",
  "description": "Material 3 style Lovelace cards for Home Assistant — 40 cards across energy, climate, light and media, household and safety — built natively with Lit, with no button-card or card-mod dependency.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contrast": "esbuild src/shared/contrast.ts --format=esm --outfile=.contrast.mjs --log-level=error && node test/contrast.test.mjs $PWD/.contrast.mjs; rm -f .contrast.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "climate"
  ],
  "license": "MIT",
  "author": "j0sp0r",
  "repository": {
    "type": "git",
    "url": "https://github.com/j0sp0r/m3-cards.git"
  },
  "homepage": "https://github.com/j0sp0r/m3-cards",
  "bugs": "https://github.com/j0sp0r/m3-cards/issues",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
